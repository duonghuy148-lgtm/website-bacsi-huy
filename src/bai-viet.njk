---
layout: base.njk
title: Bài viết
permalink: /bai-viet/
description: Kiến thức thai sản và phụ khoa từ bác sĩ, viết dễ hiểu cho chị em.
---
{% from "card.njk" import card %}
<section>
  <div class="wrap">
    <nav class="crumb"><a href="/">Trang chủ</a><span>›</span><span>Bài viết</span></nav>
    <div class="sec-head" style="margin-top:1rem"><div><h1 style="font-size:clamp(1.9rem,4.5vw,2.5rem)">Tất cả bài viết</h1></div></div>
    <div class="quick" style="padding-block:0 1.6rem;border:0"><div style="display:flex;flex-wrap:wrap;gap:.5rem">{% for c in site.categories %}<a class="chip" href="/chuyen-muc/{{ c.slug }}/">{{ c.name }} ({{ (collections.posts | byCategory(c.name)).length }})</a>{% endfor %}</div></div>
    <div class="cards">{% for post in collections.posts %}{{ card(post, site.categories) }}{% endfor %}</div>
  </div>
</section>
